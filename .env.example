# Google Gemini API key (for Nano Banana Pro image gen + Veo 3.1 video gen)
GEMINI_API_KEY=your-gemini-api-key

# ElevenLabs API key (for conversational audio ads)
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# Anthropic API key (optional — only needed if CREATIVE_LLM=claude)
ANTHROPIC_API_KEY=your-anthropic-api-key

# LLM provider for creative director prompt engineering: "gemini" or "claude"
# Defaults to "gemini" (reuses GEMINI_API_KEY, no extra key needed)
CREATIVE_LLM=gemini

# API authentication key (AgentForce sends this in X-API-Key header)
API_KEY=your-api-key

# Server settings
HOST=0.0.0.0
PORT=8000
BASE_URL=https://your-ngrok-url.ngrok-free.app
